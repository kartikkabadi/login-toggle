#!/bin/bash
# login-off — one button to turn off every app that opens at login. Undo: login-on.
# Covers: classic login items (System Events) + non-Apple launch agents with RunAtLoad/KeepAlive.
# Not covered: macOS 13+ "Allow in Background" items (SMAppService) — no public API, see System Settings.
set -u

STATE="$HOME/.local/state/login-toggle"
mkdir -p "$STATE"
U=$(id -u)

# 1) classic login items: collect, persist atomically, then delete.
# AppleScript only returns data; all file I/O happens here in bash, and the
# backup must be on disk before anything is deleted.
collect=$(osascript <<'EOF'
tell application "System Events"
	set lis to every login item
	if (count of lis) is 0 then return ""
	set acc to ""
	repeat with li in lis
		set p to path of li
		if p is missing value then set p to "-"
		set acc to acc & (name of li) & (ASCII character 9) & p & linefeed
	end repeat
	return acc
end tell
EOF
) || true

if [ -z "$collect" ]; then
	echo "login items: none found (or Automation permission missing — check System Settings > Privacy > Automation)"
else
	tmp="$STATE/login-items.tsv.tmp"
	{
		[ -f "$STATE/login-items.tsv" ] && cat "$STATE/login-items.tsv"
		printf '%s\n' "$collect"
	} | awk -F'\t' '!seen[$0]++' > "$tmp"
	if [ -s "$tmp" ] && mv "$tmp" "$STATE/login-items.tsv"; then
		if osascript -e 'tell application "System Events" to delete every login item' >/dev/null 2>&1; then
			echo "login items: removed (saved to $STATE/login-items.tsv)"
		else
			echo "login items: delete failed — items left in place, backup kept at $STATE/login-items.tsv" >&2
		fi
	else
		echo "backup write failed — login items left untouched" >&2
		rm -f "$tmp"
		exit 1
	fi
fi

# 2) launch agents that run at login: save labels, stop now, disable persistently
: > "$STATE/launch-agents.txt"
n=0
for d in "$HOME/Library/LaunchAgents" "/Library/LaunchAgents"; do
	[ -d "$d" ] || continue
	for plist in "$d"/*.plist; do
		[ -e "$plist" ] || continue
		label=$(/usr/libexec/PlistBuddy -c 'Print :Label' "$plist" 2>/dev/null) || continue
		case "$label" in com.apple.*) continue ;; esac
		runat=$(/usr/libexec/PlistBuddy -c 'Print :RunAtLoad' "$plist" 2>/dev/null || echo false)
		ka=no
		/usr/libexec/PlistBuddy -c 'Print :KeepAlive' "$plist" >/dev/null 2>&1 && ka=yes
		[ "$runat" = "true" ] || [ "$ka" = "yes" ] || continue
		echo "$label" >> "$STATE/launch-agents.txt"
		launchctl bootout "gui/$U/$label" 2>/dev/null
		launchctl disable "gui/$U/$label" 2>/dev/null && n=$((n+1))
	done
done
echo "launch agents: disabled $n (labels saved to $STATE/launch-agents.txt)"
echo "undo with: login-on"

#!/bin/bash
# login-off — one button to turn off every app that opens at login. Undo: login-on.
# Covers: classic login items (System Events) + non-Apple launch agents with RunAtLoad/KeepAlive.
# Not covered: macOS 13+ "Allow in Background" items (SMAppService) — no public API, see System Settings.
set -uo pipefail

STATE="$HOME/.local/state/login-toggle"
mkdir -p "$STATE"
U=$(id -u)
TMP_SUFFIX=".$$.tmp"

# 1) classic login items: collect (read-only), merge into the backup, persist
# atomically, then delete only the captured paths. AppleScript returns data and
# receives paths as arguments — nothing is interpolated into script source.
collect=$(osascript <<'EOF'
tell application "System Events"
	set lis to every login item
	if (count of lis) is 0 then return ""
	set acc to ""
	repeat with li in lis
		set p to path of li
		if p is missing value then set p to "-"
		set acc to acc & (name of li) & (ASCII character 9) & p & linefeed
	end repeat
	return acc
end tell
EOF
) || true

if [ -z "$collect" ]; then
	echo "login items: none found (or Automation permission missing — check System Settings > Privacy > Automation)"
	exit 0
fi

# merge prior saved records with the current snapshot; abort if the existing
# backup cannot be read so nothing is discarded silently
old=""
if [ -f "$STATE/login-items.tsv" ]; then
	old=$(cat "$STATE/login-items.tsv") || { echo "backup read failed — login items left untouched" >&2; exit 1; }
fi
tmp="$STATE/login-items.tsv.tmp$TMP_SUFFIX"
{
	[ -n "$old" ] && printf '%s\n' "$old"
	printf '%s\n' "$collect"
} | awk -F'\t' '!seen[$0]++' > "$tmp"
if [ ! -s "$tmp" ]; then
	echo "backup merge failed — login items left untouched" >&2
	rm -f "$tmp"
	exit 1
fi
if ! mv "$tmp" "$STATE/login-items.tsv"; then
	echo "backup replace failed — login items left untouched" >&2
	rm -f "$tmp"
	exit 1
fi

# delete only the paths captured in this run's snapshot
deleted=0
failed=0
pathless=0
collect_tmp="$STATE/.collect.tmp$TMP_SUFFIX"
if printf '%s\n' "$collect" > "$collect_tmp" && [ -s "$collect_tmp" ]; then
	while IFS= read -r line; do
		[ -z "$line" ] && continue
		path=${line#*	}
		[ "$path" = "$line" ] && path=""
		if [ -z "$path" ] || [ "$path" = "-" ]; then
			# pathless: no stable identifier to target — leave in place, report
			pathless=$((pathless+1))
			continue
		fi
		if osascript - "$path" <<'EOF' >/dev/null 2>&1
on run argv
	set p to item 1 of argv
	tell application "System Events" to delete (every login item whose path is p)
end run
EOF
		then
			deleted=$((deleted+1))
		else
			failed=$((failed+1))
		fi
	done < "$collect_tmp"
else
	echo "deletion list write failed — login items left untouched" >&2
	rm -f "$collect_tmp"
	exit 1
fi
rm -f "$collect_tmp"
echo "login items: removed $deleted, failed $failed (backup at $STATE/login-items.tsv)"
[ $failed -eq 0 ] || echo "warning: $failed login item(s) could not be removed — they remain enabled" >&2
[ $pathless -eq 0 ] || echo "note: $pathless login item(s) without a path were left enabled (cannot be restored)" >&2

# 2) launch agents that run at login: save labels, stop now, disable persistently
: > "$STATE/launch-agents.txt"
n=0
for d in "$HOME/Library/LaunchAgents" "/Library/LaunchAgents"; do
	[ -d "$d" ] || continue
	for plist in "$d"/*.plist; do
		[ -e "$plist" ] || continue
		label=$(/usr/libexec/PlistBuddy -c 'Print :Label' "$plist" 2>/dev/null) || continue
		case "$label" in com.apple.*) continue ;; esac
		runat=$(/usr/libexec/PlistBuddy -c 'Print :RunAtLoad' "$plist" 2>/dev/null || echo false)
		ka=no
		/usr/libexec/PlistBuddy -c 'Print :KeepAlive' "$plist" >/dev/null 2>&1 && ka=yes
		[ "$runat" = "true" ] || [ "$ka" = "yes" ] || continue
		echo "$label" >> "$STATE/launch-agents.txt"
		launchctl bootout "gui/$U/$label" 2>/dev/null
		launchctl disable "gui/$U/$label" 2>/dev/null && n=$((n+1))
	done
done
echo "launch agents: disabled $n (labels saved to $STATE/launch-agents.txt)"
echo "undo with: login-on"

#!/bin/bash
# login-on — undo login-off: restore login items and re-enable launch agents.
# Skips items that are already live (safe to re-run). Keeps the backup if
# anything fails to restore, so a rerun can finish the job.
set -uo pipefail

STATE="$HOME/.local/state/login-toggle"
U=$(id -u)

if [ -f "$STATE/launch-agents.txt" ]; then
	n=0
	f=0
	while IFS= read -r label; do
		[ -z "$label" ] && continue
		launchctl enable "gui/$U/$label" 2>/dev/null
		ok=yes
		booted=no
		for d in "$HOME/Library/LaunchAgents" "/Library/LaunchAgents"; do
			[ -e "$d/$label.plist" ] || continue
			if launchctl bootstrap "gui/$U" "$d/$label.plist" 2>/dev/null; then
				booted=yes
			elif launchctl print "gui/$U/$label" >/dev/null 2>&1; then
				booted=yes
			else
				ok=no
			fi
		done
		if [ "$ok" = "yes" ] && [ "$booted" = "yes" ]; then
			n=$((n+1))
		else
			f=$((f+1))
		fi
	done < "$STATE/launch-agents.txt"
	echo "launch agents re-enabled: $n (started now where possible)"
	if [ $f -eq 0 ]; then
		rm -f "$STATE/launch-agents.txt"
	else
		echo "$f agent(s) failed to re-enable — labels kept, run login-on again" >&2
	fi
fi

if [ -f "$STATE/login-items.tsv" ]; then
	n=0
	f=0
	u=0
	while IFS=$'\t' read -r name path; do
		[ -z "$path" ] || [ "$path" = "-" ] && continue
		if [ ! -e "$path" ]; then
			u=$((u+1))
			continue
		fi
		exists=$(osascript - "$path" <<'EOF' 2>/dev/null
on run argv
	set p to item 1 of argv
	tell application "System Events" to count (login items whose path is p)
end run
EOF
)
		if [ "${exists:-0}" -ge 1 ] 2>/dev/null; then
			n=$((n+1))
			continue
		fi
		if osascript - "$path" <<'EOF' >/dev/null 2>&1
on run argv
	set p to item 1 of argv
	tell application "System Events" to make login item at end with properties {path:p, hidden:false}
end run
EOF
		then
			n=$((n+1))
		else
			f=$((f+1))
		fi
	done < "$STATE/login-items.tsv"
	echo "login items restored: $n"
	if [ $((f + u)) -eq 0 ]; then
		rm -f "$STATE/login-items.tsv"
	else
		echo "$u saved item(s) unavailable (app moved or deleted?) and $f failed — backup kept at $STATE/login-items.tsv" >&2
	fi
fi
